Comment: 0,0:00:00.00,0:02:07.27,Abertura JP,,0,0,0,code syl, local numColors = #tenv.alpha local colorIndex if numColors == 0 then colorIndex = 1 elseif numColors == 1 then colorIndex = 1 else repeat colorIndex = math.random(numColors) until colorIndex ~= tenv.previousChosenIndex end tenv.previousChosenIndex = colorIndex tenv.set('currentColorAlpha', tenv.alpha[colorIndex]) tenv.set('currentColorDelta', tenv.delta[colorIndex]) local syl = tenv.syl local orgline = tenv.orgline local x_start, y_start local x_end, y_end local isFirstSylOfLine = (tenv.previousSylEndTime == nil) local isPause = false if not isFirstSylOfLine then if (syl.start_time - tenv.previousSylEndTime) > tenv.pauseThreshold then isPause = true end end if isFirstSylOfLine or isPause then x_start = orgline.left else x_start = tenv.currentLineX end local sylWidth = syl.right - syl.left if sylWidth <= 0 then sylWidth = 5 end x_end = x_start + sylWidth if isFirstSylOfLine or isPause then y_start = tenv.lineBaseY + math.random(-tenv.yRandomRange, tenv.yRandomRange) else y_start = tenv.currentLineY end y_end = tenv.lineBaseY + math.random(-tenv.yRandomRange, tenv.yRandomRange) tenv.set('moveX1', string.format("%.2f", x_start)) tenv.set('moveY1', string.format("%.2f", y_start)) tenv.set('moveX2', string.format("%.2f", x_end)) tenv.set('moveY2', string.format("%.2f", y_end)) tenv.set('moveDurStart', 0) tenv.set('moveDurEnd', syl.duration) tenv.currentLineX = x_end tenv.currentLineY = y_end tenv.previousSylEndTime = syl.end_time
