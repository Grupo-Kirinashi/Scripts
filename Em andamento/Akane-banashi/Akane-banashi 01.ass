Comment: 0,0:00:00.00,0:00:00.00,Abertura,,0,0,0,code once,tenv.make_rough_box = function(w, h, step, var) local pts = {}  for x = 0, w, step do table.insert(pts, string.format("%.1f %.1f", x, math.random(-var, var))) end  for y = 0, h, step do table.insert(pts, string.format("%.1f %.1f", w + math.random(-var, var), y)) end  for x = math.floor(w), 0, -step do table.insert(pts, string.format("%.1f %.1f", x, h + math.random(-var, var))) end  for y = math.floor(h), 0, -step do table.insert(pts, string.format("%.1f %.1f", math.random(-var, var), y)) end  return "m " .. table.concat(pts, " l ") end
